<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>Panduan Ziarah Umrah — Sejarah, Dalil &amp; Pengajaran</title>
<meta name="description" content="Panduan ziarah bergambar tempat-tempat bersejarah — Ustaz Syed Syukran, Mursyid Al-Haramain">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --teal-deep:#0F4C5C;
  --teal-mid:#1F6F78;
  --gold:#B8862B;
  --gold-soft:#D9B463;
  --ink:#20241f;
  --grey:#5b6660;
  --line:#dfe3d8;
  --cream:#F8F5EC;
  --cream-2:#EFEADA;
  --card-bg:#FFFFFF;
  --shadow: 0 6px 24px -8px rgba(15,76,92,0.25);
  --radius: 14px;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background:var(--cream);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
}
.arfont{ font-family:'Amiri','Noto Naskh Arabic','Traditional Arabic', serif; direction:rtl; text-align:right; }
.serif{ font-family:'Cormorant Garamond', Georgia, serif; }

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
}

/* ---------- Ornament ---------- */
.ornament{
  display:flex; align-items:center; justify-content:center; gap:10px;
  color:var(--gold); opacity:.85; user-select:none;
}
.ornament svg{ width:22px; height:22px; flex:none; }
.ornament .dots{
  flex:1; max-width:220px; height:1px;
  background-image: radial-gradient(circle, var(--gold-soft) 1.4px, transparent 1.6px);
  background-size: 10px 1px;
  background-repeat: repeat-x;
  opacity:.9;
}

/* ---------- Header ---------- */
header.site{
  position:sticky; top:0; z-index:40;
  background:linear-gradient(180deg, var(--teal-deep), #0c3e4b 88%);
  color:#f4f1e6;
  padding:14px 16px 12px;
  box-shadow:0 4px 18px rgba(0,0,0,.18);
}
.header-inner{ max-width:1180px; margin:0 auto; }
.title-row{ display:flex; align-items:center; gap:12px; }
.title-row .crest{ width:38px; height:38px; flex:none; color:var(--gold-soft); }
.title-row h1{
  font-family:'Cormorant Garamond', Georgia, serif;
  font-weight:700; font-size:clamp(20px,4.2vw,28px);
  margin:0; letter-spacing:.2px; color:#fbf8ee;
}
.title-row .subtitle{
  font-size:12.5px; color:#cfe4e3; margin-top:2px; letter-spacing:.3px;
}
.header-meta{
  display:flex; justify-content:space-between; align-items:flex-end; gap:12px; flex-wrap:wrap;
  margin-top:10px;
}
.count-pill{
  font-size:11.5px; color:#d8e9e4; background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.16); padding:4px 10px; border-radius:999px;
  white-space:nowrap;
}
.searchwrap{ margin-top:12px; position:relative; }
.searchwrap input{
  width:100%; padding:11px 40px 11px 14px; border-radius:11px; border:1px solid rgba(255,255,255,.18);
  background:rgba(255,255,255,.08); color:#fff; font-size:15px; font-family:inherit;
  outline:none; transition:background .2s, border-color .2s;
}
.searchwrap input::placeholder{ color:#c9d9d6; }
.searchwrap input:focus{ background:rgba(255,255,255,.14); border-color:var(--gold-soft); }
.searchwrap svg{ position:absolute; right:12px; top:50%; transform:translateY(-50%); width:17px; height:17px; color:#cfe4e3; pointer-events:none; }

.chips{
  display:flex; gap:8px; margin-top:12px; overflow-x:auto; padding-bottom:2px;
  scrollbar-width:none;
}
.chips::-webkit-scrollbar{ display:none; }
.chip{
  flex:none; font-size:13px; font-weight:600; letter-spacing:.2px;
  padding:7px 14px; border-radius:999px; cursor:pointer; white-space:nowrap;
  border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.05); color:#e7f0ee;
  transition:all .18s ease;
}
.chip:hover{ background:rgba(255,255,255,.14); }
.chip.active{ background:var(--gold); border-color:var(--gold); color:#26210a; }

/* ---------- Layout ---------- */
main{ max-width:1180px; margin:0 auto; padding:20px 16px 60px; }

.section-divider{
  display:flex; align-items:center; gap:14px; margin:30px 2px 16px;
}
.section-divider:first-child{ margin-top:6px; }
.section-divider h2{
  font-family:'Cormorant Garamond', Georgia, serif; font-weight:700;
  font-size:clamp(19px,3vw,24px); color:var(--teal-deep); margin:0; white-space:nowrap;
}
.section-divider .rule{ flex:1; height:1px; background:linear-gradient(90deg, var(--gold-soft), transparent); }
.section-divider .n{ font-size:12px; color:var(--grey); background:var(--cream-2); padding:3px 9px; border-radius:999px; white-space:nowrap; }

.grid{
  display:grid; gap:16px;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
}
.card{
  background:var(--card-bg); border-radius:var(--radius); overflow:hidden;
  box-shadow:0 2px 10px -4px rgba(15,76,92,.18); border:1px solid #eae6d6;
  cursor:pointer; transition:transform .18s ease, box-shadow .18s ease;
  display:flex; flex-direction:column;
}
.card:hover{ transform:translateY(-3px); box-shadow:var(--shadow); }
.card:focus-visible{ outline:3px solid var(--gold); outline-offset:2px; }
.card .thumb{
  position:relative; aspect-ratio:4/3; overflow:hidden; background:linear-gradient(135deg, var(--cream-2), #f5e9c8);
}
.card .thumb img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform .35s ease; }
.card:hover .thumb img{ transform:scale(1.05); }
.card .thumb::after{
  content:""; position:absolute; inset:0;
  background:linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(10,30,30,.55) 100%);
}
.card .thumb.no-image{
  display:flex; align-items:center; justify-content:center;
  color:var(--gold); opacity:.65;
}
.card .thumb.no-image::after{ display:none; }
.card .thumb.no-image svg{ width:52px; height:52px; }
.card .tag{
  position:absolute; top:8px; left:8px; z-index:2;
  font-size:10.5px; font-weight:700; letter-spacing:.4px; text-transform:uppercase;
  background:rgba(255,255,255,.88); color:var(--teal-deep); padding:3px 8px; border-radius:999px;
}
.card .body{ padding:12px 13px 14px; }
.card h3{
  font-family:'Cormorant Garamond', Georgia, serif; font-weight:700; font-size:17.5px;
  margin:0 0 3px; color:var(--ink); line-height:1.25;
}
.card .ar{ font-size:15px; color:var(--gold); margin:0; }
.card .excerpt{ font-size:12.5px; color:var(--grey); margin:6px 0 0; line-height:1.4;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }

.empty-state{
  text-align:center; padding:60px 20px; color:var(--grey);
}
.empty-state svg{ width:40px; height:40px; color:var(--gold-soft); margin-bottom:10px; }

/* ---------- Modal ---------- */
.modal-backdrop{
  position:fixed; inset:0; background:rgba(10,20,20,.62); backdrop-filter:blur(2px);
  display:none; align-items:flex-start; justify-content:center; z-index:100;
  padding: 0; overflow-y:auto;
}
.modal-backdrop.open{ display:flex; }
.modal{
  background:var(--cream); width:100%; max-width:760px; min-height:100vh;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
  animation: slideUp .28s ease;
}
@media (min-width:760px){
  .modal-backdrop{ padding:32px 16px; align-items:flex-start; }
  .modal{ min-height:auto; border-radius:18px; margin-top:10px; overflow:hidden; }
}
@keyframes slideUp{ from{ opacity:0; transform:translateY(18px);} to{opacity:1; transform:translateY(0);} }

.modal-photos{ position:relative; background:#111; }
.modal-photos .shot{ width:100%; display:block; max-height:60vh; object-fit:cover; aspect-ratio:16/10; }
.modal-photos.two .shot{ aspect-ratio:1/1; max-height:none; }
.modal-photos.two{ display:grid; grid-template-columns:1fr 1fr; gap:2px; }
.modal-photos.three{ display:grid; grid-template-columns:2fr 1fr; grid-template-rows:1fr 1fr; gap:2px; }
.modal-photos.three .shot:first-child{ grid-row:1/3; aspect-ratio:auto; height:100%; }
.modal-photos.three .shot{ aspect-ratio:1/1; }
.modal-photos.no-image{
  background:linear-gradient(135deg, var(--teal-deep), var(--teal-mid));
  color:var(--gold-soft); padding:38px 20px; text-align:center;
}
.modal-photos.no-image svg{ width:56px; height:56px; opacity:.8; }
.modal-close{
  position:absolute; top:12px; right:12px; z-index:5;
  width:36px; height:36px; border-radius:50%; border:none;
  background:rgba(10,20,20,.55); color:#fff; font-size:18px; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  backdrop-filter:blur(3px);
}
.modal-close:hover{ background:rgba(10,20,20,.78); }
.modal-tag{
  position:absolute; top:12px; left:12px; z-index:5;
  font-size:11px; font-weight:700; letter-spacing:.4px; text-transform:uppercase;
  background:rgba(255,255,255,.9); color:var(--teal-deep); padding:4px 10px; border-radius:999px;
}

.modal-content{ padding:22px 22px 34px; }
.modal-content h2{
  font-family:'Cormorant Garamond', Georgia, serif; font-weight:700;
  font-size:clamp(24px,5vw,30px); margin:0 0 4px; color:var(--teal-deep);
}
.modal-content .ar-title{
  font-family:'Amiri','Noto Naskh Arabic', serif; direction:rtl;
  font-size:22px; color:var(--gold); margin:0 0 14px;
}

.block-label{
  display:flex; align-items:center; gap:8px;
  font-size:12.5px; font-weight:700; letter-spacing:.5px; text-transform:uppercase;
  color:var(--teal-mid); margin:22px 0 10px;
}
.block-label:first-of-type{ margin-top:6px; }
.block-label::after{ content:""; flex:1; height:1px; background:var(--line); }

.block-h3{
  font-family:'Cormorant Garamond', Georgia, serif; font-weight:700;
  font-size:18px; color:var(--teal-deep); margin:16px 0 6px;
}
.block-p{ font-size:15.5px; line-height:1.75; margin:0 0 12px; color:#33372f; }
.block-tr{
  margin:6px 0 4px; padding:8px 12px; border-left:3px solid var(--gold);
  background:var(--cream-2); font-style:italic; font-size:15px; line-height:1.65; color:#3a3d31;
  border-radius:0 8px 8px 0;
}
.block-src{
  font-size:12.5px; color:var(--grey); margin:0 0 14px 4px; font-style:italic;
}
.block-ar{
  font-family:'Amiri','Noto Naskh Arabic','Traditional Arabic', serif; direction:rtl; text-align:right;
  font-size:22px; line-height:2; color:var(--teal-deep); margin:14px 0 4px;
  padding:12px 16px; background:#fbf6e8; border-radius:10px;
  border-right:4px solid var(--gold-soft);
}
.block-list{ margin:0 0 12px; padding-left:22px; font-size:15px; line-height:1.7; color:#33372f; }
.block-list li{ margin-bottom:8px; }
.block-list.ol{ list-style:decimal; }
.block-list.ul{ list-style:disc; }

.modal-footer-note{
  margin-top:24px; padding-top:14px; border-top:1px dashed var(--line);
  font-size:12px; color:var(--grey); display:flex; gap:8px; align-items:flex-start;
}
.modal-footer-note svg{ width:15px; height:15px; flex:none; margin-top:1px; color:var(--gold); }

/* ---------- Footer ---------- */
footer.site{
  text-align:center; padding:30px 16px 50px; color:var(--grey); font-size:12.5px;
}
footer.site .name{ color:var(--teal-deep); font-weight:600; }

.totop{
  position:fixed; right:16px; bottom:16px; z-index:50;
  width:42px; height:42px; border-radius:50%; border:none;
  background:var(--teal-deep); color:#fff; box-shadow:0 6px 18px rgba(0,0,0,.25);
  display:flex; align-items:center; justify-content:center; cursor:pointer;
  opacity:0; pointer-events:none; transition:opacity .2s ease, transform .2s ease;
}
.totop.show{ opacity:1; pointer-events:auto; }
.totop:active{ transform:scale(.92); }

@media (max-width:480px){
  .grid{ grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); gap:12px; }
  .card h3{ font-size:15.5px; }
  .modal-content{ padding:18px 16px 28px; }
  .block-ar{ font-size:19px; padding:10px 12px; }
}
</style>
</head>
